# --- Base de datos (Supabase Postgres) ---
# Pooler de transacciones (puerto 6543) — usado en runtime por la app vía @prisma/adapter-pg.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-x-xx-xxxx-x.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler de sesión (puerto 5432) — usado solo por Prisma Migrate (ver prisma.config.ts).
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-x-xx-xxxx-x.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Google Calendar/Meet (cuenta organizadora, ver src/lib/google.ts) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Se obtiene una sola vez visitando /api/google/connect como admin
GOOGLE_REFRESH_TOKEN=""

# --- Notificaciones ---
RESEND_API_KEY=""
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
